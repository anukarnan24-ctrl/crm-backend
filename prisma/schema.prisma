// prisma/schema.prisma
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  DEV
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model User {
  id       Int     @id @default(autoincrement())
  name     String?
  email    String  @unique
  password String
  role     Role    @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  contacts Contact[]
  tasks    Task[]
}

model Lead {
  id      Int  @id @default(autoincrement())
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  name    String
  email   String?
  phone   String?
  company String?
  source  String?
  status  LeadStatus @default(NEW)

  // conversion
  convertedAt          DateTime?
  convertedToContactId Int?   @unique
  convertedToContact   Contact?  @relation("LeadToContact", fields: [convertedToContactId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([name])
}

model Contact {
  id      Int  @id @default(autoincrement())
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  name    String
  email   String?
  phone   String?
  company String?

  leadId Int?  @unique
  lead   Lead? @relation("LeadToContact")

  notes Note[]
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([name])
}

model Note {
  id        Int     @id @default(autoincrement())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

model Task {
  id      Int  @id @default(autoincrement())
  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  title       String
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([contactId])
  @@index([completedAt])
  @@index([dueDate])
}
